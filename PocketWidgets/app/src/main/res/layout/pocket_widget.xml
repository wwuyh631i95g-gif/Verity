<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp"
    android:background="@drawable/widget_background">
    <TextClock android:layout_width="match_parent" android:layout_height="wrap_content"
        android:format12Hour="h:mm" android:format24Hour="HH:mm"
        android:textColor="#F4F4F4" android:textSize="23sp" android:fontFamily="monospace" />
    <TextView android:id="@+id/widget_count" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical"
        android:text="6–7 · 0" android:textColor="#F4F4F4" android:textSize="14sp"
        android:fontFamily="monospace" />
    <Button android:id="@+id/widget_add" android:layout_width="match_parent"
        android:layout_height="38dp" android:minHeight="0dp" android:text="+1"
        android:textColor="#FFFFFF" android:backgroundTint="#30343A"/>
</LinearLayout>
